-- Drag (dari header)
local dragging, dragStart, startPos = false, nil, nil
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
Header.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = input.Position - dragStart
    Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Master toggle logic
local function toggleMaster()
    masterEnabled = not masterEnabled
    local tween = TweenInfo.new(0.2, Enum.EasingStyle.Quad)
    if masterEnabled then
        MasterBtn.Text = "DEACTIVATE"
        TweenService:Create(MasterBtn, tween, {
            BackgroundColor3 = C.BtnOn,
            TextColor3       = C.BtnOnTxt,
        }):Play()
        StatusLbl.Text       = "FPS Boost: ON"
        StatusLbl.TextColor3 = C.Green
        applyAll()
        print("[RP FPS] ✅ Boost ON")
    else
        MasterBtn.Text = "ACTIVATE"
        TweenService:Create(MasterBtn, tween, {
            BackgroundColor3 = C.BtnOff,
            TextColor3       = C.BtnOffTxt,
        }):Play()
        StatusLbl.Text       = "FPS Boost: OFF"
        StatusLbl.TextColor3 = C.TextMut
        revertAll()
        print("[RP FPS] ⏹ Boost OFF")
    end
end

MasterBtn.MouseButton1Click:Connect(toggleMaster)
if MasterBtn.TouchTap then MasterBtn.TouchTap:Connect(toggleMaster) end

print("[RP FPS] ✅ Loaded — 1 tombol buat semua")