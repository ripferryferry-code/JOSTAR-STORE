local function FindAvailableATMs()
    local map = Workspace:FindFirstChild("Map")
    if not map then return {} end
    local atms = map:FindFirstChild("ATMS")
    if not atms then return {} end
    local result = {}
    for _, ATM in next, atms:GetChildren() do
        local screen = ATM:FindFirstChild("ATMScreen")
        if screen and screen:IsA("BasePart") and screen.Transparency == 0 then
            table.insert(result, ATM)
        end
    end
    return result
end

local function FindNearestAvailableATM()
    local atms = FindAvailableATMs()
    if #atms == 0 then return nil end
    local charPos = getCharacterPosition()
    if not charPos then return atms[1] end
    local nearestATM, nearestDist = nil, math.huge
    for _, ATM in ipairs(atms) do
        local pos = ATM:GetPivot().Position
        local screen = ATM:FindFirstChild("ATMScreen")
        if screen and screen:IsA("BasePart") then
            pos = screen.Position
        end
        local dist = (pos - charPos).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearestATM = ATM
        end
    end
    return nearestATM
end

local function SwipeCardAtATM()
    setATMStatus("Finding ATM")
    local atm = FindNearestAvailableATM()
    if not atm then
        setATMStatus("ATM not available")
        return false
    end

    local pos = atm:GetPivot().Position
    local screenPart = atm:FindFirstChild("ATMScreen")
    if screenPart and screenPart:IsA("BasePart") then
        pos = screenPart.Position
    end

    setATMStatus("Going to ATM")
    blinkTeleport(pos + Vector3.new(0, 0, 2), true, true)
    task.wait(0.3)
    fixCamera()

    local oldATM = PlayerGui:FindFirstChild("ATM")
    if oldATM then oldATM:Destroy() end

    fireAllNearOnce(pos, 11)
    task.wait(0.6)

    if PlayerGui:FindFirstChild("ATM") then
        equipToolByName("card")
        task.wait(0.25)
        local atmGui = PlayerGui:FindFirstChild("ATM")
        if atmGui then
            local swipe = atmGui:FindFirstChild("Frame")
                and atmGui.Frame:FindFirstChild("Swipe")
            if swipe then
                pcall(function()
                    replicatesignal(swipe.MouseButton1Click)
                end)
                setATMStatus("Swipe successful")
                FarmState.CardSwipe = FarmState.CardSwipe + 1
                task.wait(0.3)
            else
                setATMStatus("Swipe button not found")
            end
        end

        unequipTools()

        if not LocalPlayer.Backpack:FindFirstChild("Card")
           and not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Card")) then
            return true
        end
    else
        setATMStatus("ATM failed to open")
    end

    return true
end

local function RunATMFarm()
    local target = math.clamp(tonumber(getgenv().ATMTarget) or 5, 1, 10)
    local cycleCount = 0

    while getgenv().ATMFarmActive and not getgenv().STOP_ALL and cycleCount < target do
        cycleCount = cycleCount + 1
        setATMStatus("Cycle " .. cycleCount .. "/" .. target .. " - Buy Fake ID")

        if not BuyFakeID() then
            if getgenv().ATMFarmActive and not getgenv().STOP_ALL then
                setATMStatus("Retrying (" .. cycleCount .. "/" .. target .. ")...")
                task.wait(2)
            end
            continue
        end
        if not getgenv().ATMFarmActive or getgenv().STOP_ALL then break end

        GoToBankTeller()
        if not getgenv().ATMFarmActive or getgenv().STOP_ALL then break end

        ApplyCardAtBank()
        if not getgenv().ATMFarmActive or getgenv().STOP_ALL then break end

        WaitAtBank(35)
        if not getgenv().ATMFarmActive or getgenv().STOP_ALL then break end

        if not ClaimCard() then
            if getgenv().ATMFarmActive and not getgenv().STOP_ALL then
                setATMStatus("Retrying claim (" .. cycleCount .. "/" .. target .. ")...")
                task.wait(2)
            end
            continue
        end
        if not getgenv().ATMFarmActive or getgenv().STOP_ALL then break end

        SwipeCardAtATM()
        if not getgenv().ATMFarmActive or getgenv().STOP_ALL then break end

        setATMStatus("Cycle " .. cycleCount .. "/" .. target .. " complete")
        task.wait(1)
    end

    FarmState.CardWait = 0
    if cycleCount >= target then
        setATMStatus("All " .. target .. " cycle done")
    else
        setATMStatus("Idle")
    end
    unlockPosition()
end

