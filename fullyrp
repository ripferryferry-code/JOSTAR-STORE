local function GetLiveCharacter(timeout)
    timeout = timeout or 1
    local start = os.clock()
    while os.clock() - start < timeout do
        if not LocalPlayer then task.wait(0.05); continue end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then return char, hum, hrp end
        end
        task.wait(0.05)
    end
    return nil, nil, nil
end

local function getCharacterPosition()
    local _, _, hrp = GetLiveCharacter(1)
    return hrp and hrp.Position or nil
end

local function fixCamera()
    local cam = workspace.CurrentCamera
    if not LocalPlayer then return end
    local char = LocalPlayer.Character
    if cam and char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
    end
end

local function equipToolByName(name)
    name = name:lower()
    if not LocalPlayer then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower() == name then return true end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower() == name then
                humanoid:EquipTool(tool)
                return true
            end
        end
    end
    return false
end

local function unequipTools()
    if not LocalPlayer then return end
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then humanoid:UnequipTools() end
    end
end

local function firePromptOnce(prompt)
    if not prompt or not prompt.Parent then return false end
    pcall(function()
        local od = prompt.MaxActivationDistance
        local ol = prompt.RequiresLineOfSight
        local oh = prompt.HoldDuration
        prompt.MaxActivationDistance = 9999
        prompt.RequiresLineOfSight = false
        prompt.HoldDuration = 0
        fireproximityprompt(prompt)
        task.wait(0.04)
        prompt.MaxActivationDistance = od
        prompt.RequiresLineOfSight = ol
        prompt.HoldDuration = oh
    end)
    return true
end

local function fireAllNearOnce(pos, radius)
    radius = radius or 18
    local charPos = getCharacterPosition()
    if not charPos then return false end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local distToPos  = (obj.Position - pos).Magnitude
            local distToChar = (obj.Position - charPos).Magnitude
            if distToPos <= radius and distToChar <= MAX_PROMPT_DIST then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    firePromptOnce(prompt)
                    return true
                end
            end
        end
    end
    return false
end

local function tweenTeleport(targetPos)
    if not LocalPlayer then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    startGhostMode()
    Workspace.Gravity = 0
    humanoid.PlatformStand = true

    local startP = hrp.Position
    local steps = 30
    for i = 1, steps do
        if getgenv().STOP_ALL then break end
        local alpha = i / steps
        local newPos = startP:Lerp(targetPos, alpha)
        hrp.CFrame = CFrame.new(newPos)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        task.wait(0.02)
    end

    hrp.CFrame = CFrame.new(targetPos)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

    Workspace.Gravity = originalGravity
    humanoid.PlatformStand = false
    stopGhostMode()
end

