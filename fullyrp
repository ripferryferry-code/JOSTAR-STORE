local function RunBoxFarm()
    local target = math.clamp(tonumber(getgenv().BoxTarget) or 5, 1, 10)
    boxDoneValue = 0

    setBoxStatus("Started (target " .. target .. " box)")
    task.wait(0.5)

    for boxIndex = 1, target do
        if not getgenv().BoxFarmActive then break end

        setBoxStatus("Box " .. boxIndex .. "/" .. target .. " - Damian Claim Task")
        BypassTP(BOX_NPC_POS)
        task.wait(0.8)
        fireBoxBuffer(1)
        task.wait(1.0)
        if not getgenv().BoxFarmActive then break end

        setBoxStatus("Box " .. boxIndex .. "/" .. target .. " - Create Interact")
        boxBlinkMove(BOX_CREATE_POS, true)
        task.wait(0.4)
        fireAllNearOnce(BOX_CREATE_POS, 15)
        task.wait(0.8)
        if not getgenv().BoxFarmActive then break end

        setBoxStatus("Box " .. boxIndex .. "/" .. target .. " - Equipping Crate")
        equipCrate()
        task.wait(0.3)

        setBoxStatus("Box " .. boxIndex .. "/" .. target .. " - Truck Delivering")
        boxBlinkMove(BOX_TRUCK_POS, true)
        task.wait(0.5)
