local function FormatMoney(amount)
    local formatted = tostring(math.floor(amount))
    local reversed = formatted:reverse()
    local withDots = ""
    for i = 1, #reversed do
        if i > 1 and (i - 1) % 3 == 0 then withDots = withDots .. "." end
        withDots = withDots .. reversed:sub(i, i)
    end
    return "$" .. withDots:reverse()
end

local function GetCurrentCash()
    local totalCash = 0
    if not LocalPlayer then return totalCash end
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            local name = tostring(stat.Name):lower()
            if name:find("cash") or name:find("money") or name:find("balance") or
               name:find("credit") or name:find("wealth") or name:find("dollar") then
                pcall(function()
                    local val = stat.Value
                    if type(val) == "number" then totalCash = totalCash + val
                    elseif type(val) == "string" then
                        local num = tonumber(val)
                        if num then totalCash = totalCash + num end
                    end
                end)
            end
        end
    end
    if totalCash == 0 then
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local function scanGUI(obj)
                for _, child in pairs(obj:GetChildren()) do
                    if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                        local text = tostring(child.Text or "")
                        if text:find("%$") or text:lower():find("cash") or text:lower():find("money") then
                            local amount = text:match("%$?([%d,]+)")
                            if amount then
                                local clean = amount:gsub(",", "")
                                local num = tonumber(clean)
                                if num and num > totalCash then totalCash = num end
                            end
                        end
                    end
                    if #child:GetChildren() > 0 then scanGUI(child) end
                end
            end
            pcall(scanGUI, playerGui)
        end
    end
    return totalCash
end

local function UpdateCashTracker()
    local currentCash = GetCurrentCash()
    if FarmState.StartingCash == 0 and currentCash > 0 then
        FarmState.StartingCash = currentCash
        FarmState.PreviousCash = currentCash
        FarmState.CurrentCash = currentCash
        return
    end
    if FarmState.CurrentCash == 0 and currentCash > 0 then
        FarmState.CurrentCash = currentCash
        FarmState.PreviousCash = currentCash
        if FarmState.StartingCash == 0 then FarmState.StartingCash = currentCash end
        return
    end
    FarmState.PreviousCash = FarmState.CurrentCash
    FarmState.CurrentCash = currentCash
    local change = currentCash - FarmState.PreviousCash
    if change > 0 then
        FarmState.TotalIncome = FarmState.TotalIncome + change
        FarmState.NetProfit = FarmState.NetProfit + change
    elseif change < 0 then
        local expense = math.abs(change)
        FarmState.TotalExpense = FarmState.TotalExpense + expense
        FarmState.NetProfit = FarmState.NetProfit - expense
    end
end

