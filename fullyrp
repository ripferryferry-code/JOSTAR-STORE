    local bv = Instance.new("BodyVelocity")
    bv.Name = "FarmLock"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp
    hrp.CFrame = CFrame.new(targetPos)
    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
    hrp.Anchored = true
