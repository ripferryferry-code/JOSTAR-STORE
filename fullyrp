local function ApplyCardAtBank()
    setATMStatus("Equipping Fake ID")
    equipToolByName("fake id")
    task.wait(0.5)

    setATMStatus("Applying at Bank Teller")
    local folders = Workspace:FindFirstChild("Folders")
    local npcs    = folders and folders:FindFirstChild("NPCs")
