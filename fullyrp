local function fireBoxBuffer(action)
    pcall(function()
        local Event = game:GetService("ReplicatedStorage").RemoteEvents.ReliableRemoteEvent
        local b = buffer.create(3)
        buffer.writeu8(b, 0, 22)
        buffer.writeu8(b, 1, 1)
        buffer.writeu8(b, 2, action)
        Event:FireServer(b)
    end)
end

local function getCrateTool()
    if not LocalPlayer then return nil end
    local char = LocalPlayer.Character
    if not char then return nil end
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    for _, name in ipairs(CRATE_NAMES) do
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool end
    end
    if backpack then
        for _, name in ipairs(CRATE_NAMES) do
            local tool = backpack:FindFirstChild(name)
            if tool and tool:IsA("Tool") then return tool end
        end
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                if string.find(n, "crate") or string.find(n, "box") or string.find(n, "package") then
                    return tool
                end
            end
        end
    end
    return nil
end

local function equipCrate()
    if not LocalPlayer then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end

    for _, name in ipairs(CRATE_NAMES) do
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return true end
    end
    local tool = getCrateTool()
    if tool then
        pcall(function() humanoid:EquipTool(tool) end)
        task.wait(0.15)
        return true
    end
    return false
end

local function boxBlinkMove(targetPos, isUnderground)
