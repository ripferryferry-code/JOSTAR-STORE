local function BuyFakeID()
    setATMStatus("Going to Fake ID Seller")
    task.wait(0.8)
    BypassTP(FAKEID_POS)
    task.wait(0.6)

    local deadline = os.clock() + 12
    while os.clock() < deadline do
        if getgenv().STOP_ALL or not getgenv().ATMFarmActive then return false end
        if not LocalPlayer then task.wait(0.35); continue end

        local folders = Workspace:FindFirstChild("Folders")
        local npcs    = folders and folders:FindFirstChild("NPCs")
        local seller  = npcs and npcs:FindFirstChild("FakeIDSeller")

        if seller then
            local prompt = seller:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                firePromptOnce(prompt)
            else
                fireAllNearOnce(FAKEID_POS, 18)
            end
        else
            fireAllNearOnce(FAKEID_POS, 18)
        end

        if LocalPlayer.Backpack:FindFirstChild("Fake ID")
           or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Fake ID")) then
            setATMStatus("Fake ID obtained")
            task.wait(0.4)
            return true
        end

        task.wait(0.35)
    end

    setATMStatus("Fake ID failed")
    return false
end

